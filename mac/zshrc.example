  echo -e "  \033[36mll / tree / lt\033[0m - Eza powered list (all, tree, sort by time)"
  echo -e "  \033[36mports\033[0m          - List all listening ports"
  echo -e "  \033[36mkillport\033[0m       - e.g. \033[32mkillport 3000\033[0m (Kills process on port)"
  echo -e "  \033[36mextract\033[0m        - Extracts any archive (.zip, .tar.gz, etc)"
  echo -e "  \033[36mreload\033[0m         - Reloads ~/.zshrc"
  
  echo -e "\n\033[33;1m🐳 DOCKER\033[0m"
  echo -e "  \033[36mdco / dcu / dcd\033[0m- docker compose / up -d / down"
  echo -e "  \033[36mdlog\033[0m           - docker logs"
  echo -e "  \033[36mdxe\033[0m            - docker exec -it"
  echo -e "  \033[36mdcl\033[0m            - Complete system prune (cleanup everything)"
  
  echo -e "\n\033[33;1m🌿 GIT\033[0m"
